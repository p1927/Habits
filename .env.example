# ── Habits API (Mac server) ──────────────────────────────────────────────
HABITS_PORT=8787
HABITS_DB_PATH=.habits/habits.db
HABITS_ADMIN_SECRET=change-me-admin-secret
# Match LinkedInPost local dev: API 8787, Vite 5174 (strictPort)
HABITS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://p1927.github.io

# Local dev defaults — override for Tailscale Funnel / GitHub Pages deploy
HABITS_PUBLIC_URL=http://127.0.0.1:8787
HABITS_PWA_URL=http://localhost:5174/Habits/
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Production example:
# HABITS_PUBLIC_URL=https://habits-mac.your-tailnet.ts.net
# HABITS_PWA_URL=https://p1927.github.io/Habits/
# GOOGLE_REDIRECT_URI=https://habits-mac.your-tailnet.ts.net/auth/callback

# ── Google OAuth (copy from LinkedInPost: VITE_GOOGLE_CLIENT_ID / GMAIL_CLIENT_SECRET) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

