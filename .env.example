# ── LiveKit (voice stack — Phase 3) ─────────────────────────────────────
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Bearer token the livekit_agent uses to call habits-api tools (issue via /api/issue)
HABITS_INTERNAL_BEARER=

