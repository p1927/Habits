# ── Habits API (Mac server) ──────────────────────────────────────────────
HABITS_PORT=8787
HABITS_DB_PATH=.habits/habits.db
HABITS_ADMIN_SECRET=change-me-admin-secret
# Local dev — must match pwa/.env.development VITE_HABITS_DEV_BEARER (auto-prefills PWA Settings)
HABITS_DEV_BEARER=dev-habits-local-2026
# Match LinkedInPost local dev: API 8787, Vite 5174 (strictPort)
HABITS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://p1927.github.io

# Local dev defaults — override for Cloudflare / GitHub Pages deploy
HABITS_PUBLIC_URL=http://127.0.0.1:8787
HABITS_PWA_URL=http://localhost:5174/Habits/
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Cloudflare (FreeDNS + Tunnel + Access) example:
# HABITS_PUBLIC_URL=https://api.osphere.your-domain
# HABITS_PWA_URL=https://app.osphere.your-domain/
# GOOGLE_REDIRECT_URI=https://api.osphere.your-domain/auth/callback
# HABITS_CORS_ORIGINS=...,https://app.osphere.your-domain

# ── Google OAuth (copy from LinkedInPost: VITE_GOOGLE_CLIENT_ID / GMAIL_CLIENT_SECRET) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Sheets ────────────────────────────────────────────────────────
HABITS_SHEET_LIFE=1cXX0yj5_V45-xE8nyWWksN-4vEXnWaZRL4J0rnOks_0
HABITS_SHEET_NUTRITION=1NuTCX8BjlbnM2USny5ZtyQMcDhizfNX2zmC486oJvNU
HABITS_TAB_FOOD_LOG=Daily calculation
HABITS_TAB_FOOD_DB=Nutritional Data API
HABITS_TAB_FOOD_HISTORY=Followed
HABITS_TAB_RECIPES=Save Reciepe
HABITS_TAB_MEAL_PLAN=WEEK MEALS
HABITS_TAB_BODY_CONFIG=Physiological data
HABITS_TAB_HABIT_TRACKER=Tracker
HABITS_TAB_STRATEGY=Strategy
HABITS_TAB_NOTES=Notes
HABITS_TAB_SICKNESS=Sickness
HABITS_TAB_MANAGE_DAY=Manage Day

# ── MiniMax (used by local-voice-ai agent — set in ../local-voice-ai/.env too) ──
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# Voice (LiveKit WebRTC — embedded in PWA Agent tab)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# PWA reads LiveKit URL from API token response; optional override:
# VITE_LIVEKIT_URL=ws://localhost:7880

# Legacy voice iframe (deprecated)
# VITE_VOICE_UI_URL=http://localhost:8080

# ── 21st.dev (frontend component search & AI generation) ────────────────
# Get from https://21st.dev/settings/api-keys
API_KEY_21ST=
TWENTYFIRST_TOKEN=
