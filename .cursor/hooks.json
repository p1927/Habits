{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/loop-guard-edit.sh",
        "matcher": "Write|StrReplace|EditNotebook|Delete"
      },
      {
        "command": ".cursor/hooks/loop-guard-checkpoint.sh",
        "matcher": "Write|StrReplace|EditNotebook"
      },
      {
        "command": ".cursor/hooks/loop-guard-arm.sh",
        "matcher": "Shell"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/loop-bind.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/loop-survival.sh",
        "loop_limit": 25
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/loop-guard-arm.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/loop-after-shell-wake.sh",
        "loop_limit": 25
      }
    ]
  }
}
