{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/loop-guard-edit.sh",
        "matcher": "Write|StrReplace|EditNotebook|Delete"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/loop-bind.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/loop-survival.sh",
        "loop_limit": 25
      }
    ]
  }
}
