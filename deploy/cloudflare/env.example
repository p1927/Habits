# Copy to deploy/cloudflare/.env and fill hostnames from FreeDNS.
# Credentials default from ../LinkedInPost/.env when unset below.

# Cloudflare (optional — copied from LinkedInPost/.env if omitted)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Your FreeDNS hostnames on soon.it (register osphere-api as a second subdomain for API)
HABITS_CF_APP_HOST=osphere.soon.it
HABITS_CF_API_HOST=api.osphere.soon.it

# Cloudflare Access — who may open the PWA + API in a browser
HABITS_CF_ALLOWED_EMAIL=your@gmail.com

# Tunnel + Pages names (defaults shown)
HABITS_CF_TUNNEL_NAME=habits-mac
HABITS_CF_PAGES_PROJECT=habits-pwa

# Local API port (Mac)
HABITS_PORT=8787
