# Loaded by Vite in `npm run dev` only.
# Leave API URL empty — requests go same-origin; vite.config.ts proxies to :8787.
VITE_HABITS_API_URL=
VITE_HABITS_LIVEKIT_URL=ws://localhost:7880
# Must match root .env HABITS_DEV_BEARER — auto-saved to localStorage in dev
VITE_HABITS_DEV_BEARER=dev-habits-local-2026
