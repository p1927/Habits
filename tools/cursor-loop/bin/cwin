#!/usr/bin/env python3
"""cwin — Cursor Window Instances CLI."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


def find_project_root(start: Path | None = None) -> Path:
    cur = (start or Path.cwd()).resolve()
    for _ in range(25):
        if (cur / ".cursor" / "cursor-loop.json").is_file():
            return cur
        if cur.parent == cur:
            break
        cur = cur.parent
    raise SystemExit("No .cursor/cursor-loop.json found — run install.sh first")


def load_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def package_root(project: Path) -> Path:
    m = load_json(project / ".cursor" / "cursor-loop.json")
    return project / m["package_root"]


def scripts_dir(project: Path) -> Path:
    return package_root(project) / "scripts"


def parse_checkpoint(state_text: str) -> dict[str, str]:
    out: dict[str, str] = {}
    if "## CHECKPOINT" not in state_text:
        return out
    section = state_text.split("## CHECKPOINT", 1)[1].split("\n## ", 1)[0]
    for line in section.splitlines():
        if "|" not in line:
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) >= 3 and parts[1] and parts[2]:
            key = parts[1].strip("`")
            val = parts[2].strip("`")
            if key.lower() not in ("field", "-------"):
                out[key] = val
    return out


def count_open_backlog(state_text: str) -> int:
    return sum(1 for line in state_text.splitlines() if re.match(r"^\s*- \[ \]", line))


def wake_status(project: Path, loop_id: str, interval_sec: int, phase: str, state_text: str = "") -> tuple[str, str, str, bool, str]:
    sys.path.insert(0, str(scripts_dir(project)))
    import loop_hook_lib as lib

    last_wake = lib.parse_last_wake(state_text)
    detail = lib.wake_status_detail(loop_id, interval_sec, phase, last_wake)
    return detail["wake"], detail["timer"], detail["last_tick"], detail["stale"], detail["notify"]


def load_instances(project: Path) -> tuple[dict, list[dict]]:
    sys.path.insert(0, str(scripts_dir(project)))
    import loop_hook_lib as lib

    manifest = lib.load_manifest(project)
    instances = lib.load_instances_manifest(project, manifest)
    return manifest, instances.get("instances") or []


def cmd_status(project: Path, as_json: bool) -> int:
    sys.path.insert(0, str(scripts_dir(project)))
    import loop_hook_lib as lib

    manifest, instances = load_instances(project)
    preset = manifest.get("instances_preset", "—")
    rows = []
    for entry in instances:
        loop_id = entry.get("loop_id", "")
        interval = int(entry.get("interval_sec") or 120)
        state_file = project / entry.get("state_file", "")
        state_text = state_file.read_text(encoding="utf-8") if state_file.is_file() else ""
        cp = parse_checkpoint(state_text)
        wake, timer, last_tick, stale, notify = wake_status(project, loop_id, interval, cp.get("phase", ""), state_text)
        last_wake = lib.parse_last_wake(state_text)
        detail = lib.wake_status_detail(loop_id, interval, cp.get("phase", ""), last_wake)
        operator_wake = lib.operator_wake_label(project, loop_id, detail)
        slot = lib.ui_window_slot_for_loop(project, loop_id)
        rows.append(
            {
                "loop_id": loop_id,
                "wake": wake,
                "timer": timer,
                "last_tick": last_tick,
                "stale": stale,
                "notify": notify,
                "operator_wake": operator_wake,
                "ui_window_slot": slot if slot is not None else "—",
                "interval_sec": interval,
                "phase": cp.get("phase", "—"),
                "review": cp.get("review_status", "—"),
                "backlog_open": count_open_backlog(state_text),
                "paste": f"@{entry.get('contract_doc', '')} keep working",
            }
        )
    if as_json:
        print(json.dumps({"project": str(project), "preset": preset, "instances": rows}, indent=2))
        return 0
    print(f"Window Instances — {project}")
    print(f"Preset: {preset}   Instances: {len(rows)}")
    print()
    print(
        f"{'LOOP_ID':<14} {'WAKE':<7} {'SLEEPER':<9} {'LAST_TICK':<9} {'STALE':<6} {'NOTIFY':<7} "
        f"{'OP_WAKE':<10} {'SLOT':<5} {'INT':<6} {'PHASE':<8} {'REVIEW':<8} {'BACKLOG':<7} PASTE"
    )
    for r in rows:
        stale = "yes" if r["stale"] else "—"
        print(
            f"{r['loop_id']:<14} {r['wake']:<7} {r['timer']:<9} {r['last_tick']:<9} {stale:<6} {r['notify']:<7} "
            f"{r['operator_wake']:<10} {str(r['ui_window_slot']):<5} {r['interval_sec']}s{'':<3} {r['phase']:<8} {r['review']:<8} "
            f"{r['backlog_open']:<7} {r['paste']}"
        )
    if any(r["wake"] == "SPIN" for r in rows):
        print(
            "\nSPIN = sentinel fired without completed tick — run: cwin trigger-all --force"
        )
    if any(r["stale"] for r in rows):
        print(
            "\nSTALE = last_wake much older than interval — run: cwin migrate-autonomous"
        )
    print(
        "\nAutonomous ops: cwin migrate-autonomous  |  cwin trigger-all  (inject when NOTIFY=yes)"
    )
    if any(r.get("operator_wake") == "needs_bind" for r in rows):
        print("Unbound: cwin migrate-autonomous  (reuse Habits window + Agent tabs)")
    if any(r["wake"] == "DOWN" for r in rows):
        print("\nTip: cwin trigger-all --force")
    return 0


def cmd_list(project: Path) -> int:
    _, instances = load_instances(project)
    for e in instances:
        print(f"{e.get('loop_id')}\t{e.get('archetype')}\t@{e.get('contract_doc')} keep working")
    return 0


def cmd_paste(project: Path, loop_id: str) -> int:
    _, instances = load_instances(project)
    for e in instances:
        if e.get("loop_id") == loop_id:
            print(f"@{e.get('contract_doc')} keep working")
            return 0
    raise SystemExit(f"Unknown loop_id: {loop_id}")


def cmd_presets(project: Path) -> int:
    presets_dir = package_root(project) / "window-instances" / "presets"
    for d in sorted(presets_dir.iterdir()):
        if d.is_dir() and (d / "instances.manifest.json").is_file():
            n = len(load_json(d / "instances.manifest.json").get("instances") or [])
            print(f"{d.name}\t{n} instance(s)")
    return 0


def cmd_bootstrap(project: Path, preset: str, mode: str, refresh: bool) -> int:
    script = package_root(project) / "window-instances" / "scripts" / "bootstrap_instances.py"
    cmd = ["python3", str(script), str(project), "--preset", preset, "--mode", mode]
    if refresh:
        cmd.append("--refresh")
    return subprocess.call(cmd, cwd=project)


def cmd_loop_control(project: Path, action: str, loop_id: str | None, all_loops: bool) -> int:
    script = scripts_dir(project) / "loop_control.py"
    cmd = ["python3", str(script), str(project), action]
    if all_loops or not loop_id:
        cmd.append("--all")
    elif loop_id:
        cmd.extend(["--loop-id", loop_id])
    return subprocess.call(cmd, cwd=project)


def cmd_pause(project: Path, loop_id: str | None, all_loops: bool) -> int:
    return cmd_loop_control(project, "pause", loop_id, all_loops)


def cmd_resume(project: Path, loop_id: str | None, all_loops: bool) -> int:
    return cmd_loop_control(project, "resume", loop_id, all_loops)


def cmd_stop(project: Path, loop_id: str | None, all_loops: bool) -> int:
    return cmd_loop_control(project, "stop", loop_id, all_loops)


def control_state(project: Path, loop_id: str) -> str:
    sys.path.insert(0, str(scripts_dir(project)))
    import loop_control

    return loop_control.loop_control_state(project, loop_id)
def cmd_state_snapshot(project: Path, loop_id: str, refresh: bool) -> int:
    script = scripts_dir(project) / "state_api.sh"
    if refresh:
        return subprocess.call(["bash", str(script), str(project), "--loop-id", loop_id, "refresh"])
    return subprocess.call(
        ["bash", str(script), str(project), "--loop-id", loop_id, "get", "snapshot"]
    )


def cmd_handoff_snapshot(project: Path, caller: str, target: str) -> int:
    script = scripts_dir(project) / "state_api.sh"
    return subprocess.call(
        ["bash", str(script), str(project), "--loop-id", caller, "get", "handoff", "--target", target]
    )


def cmd_refresh(project: Path, loop_id: str | None) -> int:
    cmd = ["bash", str(scripts_dir(project) / "refresh-loops.sh"), str(project)]
    if loop_id:
        cmd.extend(["--loop-id", loop_id])
    return subprocess.call(cmd, cwd=project)


def cmd_sync(project: Path) -> int:
    manifest = load_json(project / ".cursor" / "cursor-loop.json")
    preset = manifest.get("instances_preset") or ""
    if not preset:
        print("cwin sync: no instances_preset in cursor-loop.json — pass --preset", file=sys.stderr)
        return 1
    rc = cmd_install(project, preset)
    if rc:
        return rc
    migrate = scripts_dir(project) / "migrate_state_checkpoint.py"
    if migrate.is_file():
        subprocess.call(["python3", str(migrate), str(project), "--apply"], cwd=project)
    repair = scripts_dir(project) / "repair_v060_state.py"
    if repair.is_file():
        subprocess.call(["python3", str(repair), str(project)], cwd=project)
    sidecar = scripts_dir(project) / "migrate_state_sidecar.sh"
    if sidecar.is_file():
        subprocess.call(["bash", str(sidecar), str(project)], cwd=project)
    return cmd_refresh(project, None)


def cmd_worktree(project: Path, subcmd: str, loop_id: str, item_id: str) -> int:
    script = scripts_dir(project) / "instance_worktree.sh"
    cmd = ["bash", str(script), subcmd, str(project), "--loop-id", loop_id]
    if item_id:
        cmd.extend(["--item-id", item_id])
    return subprocess.call(cmd, cwd=project)


def cmd_template_check(project: Path) -> int:
    return subprocess.call(
        ["python3", str(scripts_dir(project) / "validate_instance.py"), str(project), "--strict-template"],
        cwd=project,
    )


def cmd_validate(project: Path) -> int:
    rc1 = subprocess.call(["python3", str(scripts_dir(project) / "validate_instance.py"), str(project)])
    rc2 = subprocess.call(["python3", str(scripts_dir(project) / "validate_contracts.py"), str(project)])
    return rc1 or rc2


def cmd_doctor(project: Path) -> int:
    return subprocess.call(["bash", str(scripts_dir(project) / "doctor.sh"), str(project)], cwd=project)


def cmd_audit_review(project: Path, loop_id: str | None, as_json: bool) -> int:
    script = scripts_dir(project) / "audit_review.py"
    cmd = ["python3", str(script), str(project)]
    if loop_id:
        cmd.extend(["--loop-id", loop_id])
    if as_json:
        cmd.append("--json")
    return subprocess.call(cmd, cwd=project)


def cmd_install(project: Path, preset: str | None) -> int:
    cmd = ["bash", str(package_root(project) / "install.sh"), str(project), "--symlink", "--contracts-dir", "docs/window-instances"]
    if preset:
        cmd.extend(["--preset", preset])
    return subprocess.call(cmd, cwd=project)


def cmd_create(project: Path, loop_id: str, extra: list[str]) -> int:
    script = package_root(project) / "window-instances" / "scripts" / "scaffold-instance.sh"
    return subprocess.call(["bash", str(script), loop_id, *extra, "--yes"], cwd=project)


def cmd_prove_wake(project: Path) -> int:
    return subprocess.call(["bash", str(scripts_dir(project) / "prove_wake.sh"), str(project)], cwd=project)


def cmd_watch(project: Path, idle_sec: int, as_json: bool) -> int:
    cmd = ["python3", str(scripts_dir(project) / "watch_window_instances.py"), str(project)]
    if idle_sec:
        cmd.extend(["--idle-sec", str(idle_sec)])
    if as_json:
        cmd.append("--json")
    return subprocess.call(cmd, cwd=project)


def cmd_rearm(project: Path, force: bool, all_loops: bool) -> int:
    cmd = ["bash", str(scripts_dir(project) / "rearm_all_instances.sh"), str(project)]
    if force:
        cmd.append("--force")
    if all_loops:
        cmd.append("--all")
    return subprocess.call(cmd, cwd=project)


def cmd_bind_hint(project: Path, loop_id: str) -> int:
    sys.path.insert(0, str(scripts_dir(project)))
    import loop_hook_lib as lib

    target = lib.ui_target_for_loop(project, loop_id)
    lock = lib.read_loop_lock(project, loop_id) or {}
    print(f"loop_id: {loop_id}")
    print(f"conversation_id: {target.get('conversation_id') or '—'}")
    print(f"ui_window_slot: {target.get('ui_window_slot') or '—'}")
    print(f"chat_title (binding): {target.get('chat_title') or loop_id}")
    print(f"lock updated_at: {lock.get('updated_at', '—')}")
    print(f"Bind paste: cwin paste {loop_id}")
    return 0


def cmd_provision_all(
    project: Path,
    reset_locks: bool,
    create_window: bool,
    dry_run: bool,
) -> int:
    cmd = [
        "python3",
        str(scripts_dir(project) / "provision_instances.py"),
        str(project),
        "--all",
    ]
    if reset_locks:
        cmd.append("--reset-locks")
    if create_window:
        cmd.append("--create-window")
    if dry_run:
        cmd.append("--dry-run")
    return subprocess.call(cmd, cwd=project, env={**os.environ, "PYTHONPATH": str(scripts_dir(project))})


def cmd_migrate_autonomous(
    project: Path,
    reset_locks: bool,
    create_window: bool,
    skip_daemon: bool,
) -> int:
    """One-shot migration: refresh → provision all → trigger → prove-wake → daemon."""
    scripts = scripts_dir(project)
    env = {**os.environ, "PYTHONPATH": str(scripts)}

    print("==> refresh loops")
    rc = cmd_refresh(project, None)
    if rc:
        return rc

    print("==> provision all instances (reuse-first)")
    prov_cmd = ["python3", str(scripts / "provision_instances.py"), str(project), "--all"]
    if reset_locks:
        prov_cmd.append("--reset-locks")
    if create_window:
        prov_cmd.append("--create-window")
    rc = subprocess.call(prov_cmd, cwd=project, env=env)
    if rc:
        print("provision failed", file=sys.stderr)
        return rc

    print("==> trigger-all --force")
    rc = cmd_trigger_all(project, None, True, "manual", "ladder")
    if rc:
        print("trigger-all returned non-zero (continuing)", file=sys.stderr)

    print("==> poll prove-wake (max 5 min)")
    deadline = time.time() + 300
    while time.time() < deadline:
        prove = subprocess.run(
            ["bash", str(scripts / "prove_wake.sh"), str(project)],
            cwd=project,
            env=env,
            capture_output=True,
        )
        if prove.returncode == 0:
            print("prove-wake: all ready")
            break
        time.sleep(15)
        cmd_trigger_all(project, None, True, "manual", "ladder")
    else:
        print("prove-wake: not all ready after timeout", file=sys.stderr)
        subprocess.call(["bash", str(scripts / "prove_wake.sh"), str(project)], cwd=project)
        return 1

    if skip_daemon:
        print("==> skip tick_daemon (--skip-daemon)")
        return 0

    print("==> start tick_daemon (background)")
    daemon = scripts / "tick_daemon.sh"
    subprocess.Popen(
        ["bash", str(daemon), str(project)],
        cwd=project,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    print("migrate-autonomous complete")
    return 0


def cmd_bootstrap_wake(project: Path, loop_id: str | None, all_loops: bool) -> int:
    cmd = [
        "python3",
        str(scripts_dir(project) / "wake_ladder.py"),
        str(project),
        "--mode",
        "bootstrap",
    ]
    if loop_id and not all_loops:
        cmd.extend(["--loop-id", loop_id])
    return subprocess.call(cmd, cwd=project, env={**os.environ, "PYTHONPATH": str(scripts_dir(project))})


def cmd_trigger_all(
    project: Path,
    loop_id: str | None,
    force: bool,
    reason: str,
    mode: str = "ladder",
) -> int:
    cmd = [
        "python3",
        str(scripts_dir(project) / "trigger_instance_wake.py"),
        str(project),
        "--reason",
        reason,
        "--mode",
        mode,
        "--json",
    ]
    if loop_id:
        cmd.extend(["--loop-id", loop_id])
    if force:
        cmd.append("--force")
    return subprocess.call(cmd, cwd=project, env={**os.environ, "PYTHONPATH": str(scripts_dir(project))})


def main() -> int:
    parser = argparse.ArgumentParser(prog="cwin", description="Cursor Window Instances CLI")
    parser.add_argument("project", nargs="?", default=".", help="Project root")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("status", help="Show all instances and wake state")
    p.add_argument("--json", action="store_true")
    sub.add_parser("list")
    sub.add_parser("presets")
    sub.add_parser("validate")
    sub.add_parser("doctor")
    sub.add_parser("refresh")
    p = sub.add_parser("audit-review", help="Compare HISTORY vs REVIEW_FINDINGS for skipped reviews")
    p.add_argument("--loop-id", default="")
    p.add_argument("--json", action="store_true")
    sub.add_parser("sync", help="Re-link rules/instances from package + kill stale loops")
    sub.add_parser("template-check", help="Fail if live STATE missing template CHECKPOINT fields")
    p = sub.add_parser("state", help="Print hot state snapshot (STATE.hot.json)")
    p.add_argument("loop_id")
    p.add_argument("--refresh", action="store_true", help="Rebuild sidecar from STATE.md")
    p = sub.add_parser("handoff", help="Print handoff snapshot between window instances")
    p.add_argument("caller_loop_id")
    p.add_argument("target_loop_id")
    p = sub.add_parser("worktree-status", help="Show worktree status for one loop")
    p.add_argument("loop_id")
    sub.add_parser("worktree-prune", help="Remove merged loop worktrees")
    p = sub.add_parser("paste")
    p.add_argument("loop_id")
    p = sub.add_parser("bootstrap")
    p.add_argument("--preset", required=True)
    p.add_argument("--mode", choices=("symlink", "copy"), default="symlink")
    p.add_argument("--refresh", action="store_true")
    p = sub.add_parser("pause", help="Pause loop(s): keep STATE/bindings, disarm wake")
    p.add_argument("--loop-id", default="")
    p.add_argument("--all", action="store_true")
    p = sub.add_parser("resume", help="Resume paused loop(s) and re-arm wake")
    p.add_argument("--loop-id", default="")
    p.add_argument("--all", action="store_true")
    p = sub.add_parser("stop", help="Stop loop(s): clear infra, release locks, keep STATE")
    p.add_argument("--loop-id", default="")
    p.add_argument("--all", action="store_true")
    p = sub.add_parser("install")
    p.add_argument("--preset", default="")
    p = sub.add_parser("create")
    p.add_argument("loop_id")
    p.add_argument("extra", nargs=argparse.REMAINDER)
    sub.add_parser("prove-wake", help="Check all loops ready for autonomous tick (exit 1 if not)")
    p = sub.add_parser("watch", help="Watch instance health + code idle")
    p.add_argument("--idle-sec", type=int, default=300)
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("rearm", help="Rearm instances that are DOWN/SPIN")
    p.add_argument("--force", action="store_true", help="Pass RITUAL_GATE_FORCE=1")
    p.add_argument("--all", action="store_true", help="Rearm every instance")
    p = sub.add_parser("trigger-all", help="Operator inject wake (notify-armed sleepers only)")
    p.add_argument("--loop-id", default="")
    p.add_argument("--force", action="store_true", help="Wake even if ready_for_autonomous_tick")
    p.add_argument(
        "--mode",
        default="ladder",
        choices=("ladder", "inject-only"),
    )
    p.add_argument(
        "--reason",
        default="manual",
        choices=("manual", "stale", "spin", "down", "daemon"),
    )
    p = sub.add_parser("bind-hint", help="Show provision metadata (slot, conversation_id)")
    p.add_argument("loop_id")
    p = sub.add_parser("provision-all", help="Autonomous provision: reuse Habits window + Agent tabs")
    p.add_argument("--reset-locks", action="store_true", help="Force-reset locks before provision")
    p.add_argument("--force", action="store_true", help="Alias for --reset-locks (legacy)")
    p.add_argument(
        "--create-window",
        action="store_true",
        help="Create Habits window if missing (single window, not four)",
    )
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("migrate-autonomous", help="One-shot: refresh → provision → trigger → prove-wake → daemon")
    p.add_argument("--reset-locks", action="store_true", help="Force-reset locks before re-provision")
    p.add_argument("--force", action="store_true", help="Alias for --reset-locks (legacy)")
    p.add_argument(
        "--create-window",
        action="store_true",
        help="Create Habits window if missing (single window, not four)",
    )
    p.add_argument("--skip-daemon", action="store_true")
    p = sub.add_parser("bootstrap-wake", help="Bootstrap unbound instances (auto-provision)")
    p.add_argument("--loop-id", default="")
    p.add_argument("--all", action="store_true")

    args = parser.parse_args()
    project = find_project_root(Path(args.project))

    cmds = {
        "status": lambda: cmd_status(project, args.json),
        "list": lambda: cmd_list(project),
        "paste": lambda: cmd_paste(project, args.loop_id),
        "presets": lambda: cmd_presets(project),
        "validate": lambda: cmd_validate(project),
        "doctor": lambda: cmd_doctor(project),
        "audit-review": lambda: cmd_audit_review(
            project, args.loop_id or None, getattr(args, "json", False)
        ),
        "refresh": lambda: cmd_refresh(project, None),
        "sync": lambda: cmd_sync(project),
        "template-check": lambda: cmd_template_check(project),
        "state": lambda: cmd_state_snapshot(
            project, args.loop_id, getattr(args, "refresh", False)
        ),
        "handoff": lambda: cmd_handoff_snapshot(
            project, args.caller_loop_id, args.target_loop_id
        ),
        "worktree-status": lambda: cmd_worktree(project, "status", args.loop_id, ""),
        "worktree-prune": lambda: cmd_worktree(project, "prune", "", ""),
        "pause": lambda: cmd_pause(
            project, None if args.all else (args.loop_id or None), args.all
        ),
        "resume": lambda: cmd_resume(
            project, None if args.all else (args.loop_id or None), args.all
        ),
        "stop": lambda: cmd_stop(
            project, None if args.all else (args.loop_id or None), args.all
        ),
        "bootstrap": lambda: cmd_bootstrap(project, args.preset, args.mode, args.refresh),
        "install": lambda: cmd_install(project, args.preset or None),
        "create": lambda: cmd_create(project, args.loop_id, args.extra),
        "prove-wake": lambda: cmd_prove_wake(project),
        "watch": lambda: cmd_watch(project, args.idle_sec, getattr(args, "json", False)),
        "rearm": lambda: cmd_rearm(project, getattr(args, "force", False), getattr(args, "all", False)),
        "trigger-all": lambda: cmd_trigger_all(
            project,
            args.loop_id or None,
            getattr(args, "force", False),
            getattr(args, "reason", "manual"),
            getattr(args, "mode", "ladder"),
        ),
        "bind-hint": lambda: cmd_bind_hint(project, args.loop_id),
        "provision-all": lambda: cmd_provision_all(
            project,
            getattr(args, "reset_locks", False) or getattr(args, "force", False),
            getattr(args, "create_window", False),
            getattr(args, "dry_run", False),
        ),
        "migrate-autonomous": lambda: cmd_migrate_autonomous(
            project,
            getattr(args, "reset_locks", False) or getattr(args, "force", False),
            getattr(args, "create_window", False),
            getattr(args, "skip_daemon", False),
        ),
        "bootstrap-wake": lambda: cmd_bootstrap_wake(
            project,
            args.loop_id or None,
            getattr(args, "all", False),
        ),
    }
    return cmds[args.command]()


if __name__ == "__main__":
    raise SystemExit(main())
