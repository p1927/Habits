{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/loop-guard-arm.sh",
        "matcher": "Shell"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/loop-guard-arm.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/loop-after-shell-wake.sh",
        "loop_limit": 25
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/loop-bind.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/loop-survival.sh",
        "loop_limit": 25
      }
    ]
  }
}
